APP_NAME="Merqio POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/sme_manager/public
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# Database
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sme_manager
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------
# Session
# -----------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------
# Broadcasting, Cache & Queue
# -----------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=sme_

# -----------------------------------------------
# Mail
# -----------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Merqio POS"

# -----------------------------------------------
# M-Pesa Daraja — platform subscription billing only.
# Per-business sale payments use credentials each business enters
# themselves in Settings → M-Pesa, not these.
# Get sandbox credentials at https://developer.safaricom.co.ke
# -----------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_TILL_NUMBER=

# When going LIVE, switch the values above to:
# MPESA_ENVIRONMENT=production
# MPESA_CONSUMER_KEY=your_production_key
# MPESA_CONSUMER_SECRET=your_production_secret
# MPESA_SHORTCODE=your_real_paybill_or_till
# MPESA_PASSKEY=your_production_passkey

# -----------------------------------------------
# Paystack — platform subscription billing (money goes to the developer,
# not to individual businesses). Get keys from
# https://dashboard.paystack.com/#/settings/developer
# -----------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

VITE_APP_NAME="Merqio POS"

# -----------------------------------------------
# Backups — see App\Console\Commands\RunBackup (runs daily via the
# scheduler in routes/console.php). On-server backup happens either way;
# leave this unset to skip the off-site email copy.
# -----------------------------------------------
BACKUP_NOTIFY_EMAIL=

# -----------------------------------------------
# Google Sign-In/Sign-Up — create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials with an authorized
# redirect URI matching GOOGLE_REDIRECT_URI below exactly (scheme + host +
# path, no trailing slash).
# -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://merqiopos.com/auth/google/callback
